# AgentX 环境变量配置参考
# ⚠️ 本文件仅作配置项文档用途，应用运行时 MUST NOT 读取（pydantic-settings env_file=None）。
# 凭证由 Electron Main 进程从 electron-store (safeStorage 解密) 后通过进程 env 注入。

# ---- FastAPI ----
AGENTX_HOST=127.0.0.1
AGENTX_PORT=8123

# ---- LLM (from electron-store safeStorage) ----
# 默认走 OpenAI；通过 OPENAI_BASE_URL 可指向 MiniMax Token Plan 等 OpenAI 兼容端点。
# 接入 MiniMax 示例：OPENAI_API_KEY=sk-cp-...，OPENAI_BASE_URL=https://api.minimax.chat/v1
AGENTX_OPENAI_API_KEY=<from electron-store>
AGENTX_OPENAI_BASE_URL=
AGENTX_ANTHROPIC_API_KEY=<from electron-store>
AGENTX_DASHSCOPE_API_KEY=<from electron-store>
AGENTX_DEEPSEEK_API_KEY=<from electron-store>
AGENTX_DEFAULT_MODEL=gpt-4o-mini

# ---- Embedding (BGE-M3 service on myserver:8093) ----
AGENTX_EMBEDDING_URL=http://192.168.1.4:8093/v1/embeddings
AGENTX_EMBEDDING_MODEL=bge-m3
AGENTX_EMBEDDING_TIMEOUT=10
AGENTX_EMBEDDING_MAX_BATCH=32
AGENTX_EMBEDDING_MAX_CHARS=24000

# ---- Milvus (credentials from electron-store safeStorage) ----
AGENTX_MILVUS_HOST=192.168.1.4
AGENTX_MILVUS_PORT=19530
AGENTX_MILVUS_USER=<from electron-store safeStorage>
AGENTX_MILVUS_PASSWORD=<from electron-store safeStorage>
AGENTX_MILVUS_DB=agentx
AGENTX_MILVUS_COLLECTION=agentx_knowledge
# myserver Milvus authorizationEnabled=false 时设 false，跳过凭证校验
AGENTX_MILVUS_AUTH_ENABLED=true

# ---- 危险操作审批 ----
# 0=禁用（无限期暂停等用户操作）；>0 时倒计时归零自动批准
AGENTX_AUTO_APPROVE_AFTER_SECONDS=0

# ---- 沙箱 ----
AGENTX_PERSIST_AUTHORIZED_DIRS=true

# ---- LangSmith ----
LANGSMITH_API_KEY=<from electron-store>
LANGSMITH_PROJECT=agentx
LANGSMITH_TRACING=false