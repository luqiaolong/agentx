# AgentPy 环境变量配置参考
# ⚠️ 本文件仅作配置项文档用途，应用运行时 MUST NOT 读取（pydantic-settings env_file=None）。
# 凭证由 Electron Main 进程从 electron-store (safeStorage 解密) 后通过进程 env 注入。

# ---- FastAPI ----
AGENT_PY_HOST=127.0.0.1
AGENT_PY_PORT=8123

# ---- LLM (from electron-store safeStorage) ----
AGENT_PY_OPENAI_API_KEY=<from electron-store>
AGENT_PY_ANTHROPIC_API_KEY=<from electron-store>
AGENT_PY_DASHSCOPE_API_KEY=<from electron-store>
AGENT_PY_DEEPSEEK_API_KEY=<from electron-store>
AGENT_PY_DEFAULT_MODEL=gpt-4o-mini

# ---- Embedding (TEI) ----
AGENT_PY_EMBEDDING_URL=http://192.168.1.4:8080/embed
AGENT_PY_EMBEDDING_MODEL=bge-m3
AGENT_PY_EMBEDDING_TIMEOUT=10
AGENT_PY_EMBEDDING_MAX_BATCH=32
AGENT_PY_EMBEDDING_MAX_CHARS=24000

# ---- Milvus (credentials from electron-store safeStorage) ----
AGENT_PY_MILVUS_HOST=192.168.1.4
AGENT_PY_MILVUS_PORT=19530
AGENT_PY_MILVUS_USER=<from electron-store safeStorage>
AGENT_PY_MILVUS_PASSWORD=<from electron-store safeStorage>
AGENT_PY_MILVUS_DB=agent_py
AGENT_PY_MILVUS_COLLECTION=agent_py_knowledge

# ---- 危险操作审批 ----
# 0=禁用（无限期暂停等用户操作）；>0 时倒计时归零自动批准
AGENT_PY_AUTO_APPROVE_AFTER_SECONDS=0

# ---- 沙箱 ----
AGENT_PY_PERSIST_AUTHORIZED_DIRS=true

# ---- LangSmith ----
LANGSMITH_API_KEY=<from electron-store>
LANGSMITH_PROJECT=agent-py
LANGSMITH_TRACING=false
