# LangSmith 部署 .env 模板（社区 dev 模式）
# 复制本文件为 .env，填入实际值（cp .env.template .env）
# .env 在 .gitignore 中，不进 git

# ===== 必填（无 fallback，docker compose 启动会失败）=====

# License key：联系 LangChain 商务团队申请 trial 或 Enterprise
# 注意：原 license.json 格式若是结构化 JSON，本字段仅取其中的 key 字段值
LANGSMITH_LICENSE_KEY=lsv2_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API key salt：随机字符串，用于 hash 存储的 API key（**一旦设置永不修改**，否则现存 API key 全失效）
# 生成：openssl rand -base64 32
API_KEY_SALT=replace_with_openssl_rand_base64_32_output_xxxxxxxxxxxxxxxxxxxxx

# 初始 admin 账号（首次启动会自动创建）
# 密码必须 ≥12 字符，含大小写+符号
INITIAL_ORG_ADMIN_EMAIL=admin@agentx.local
INITIAL_ORG_ADMIN_PASSWORD=ChangeMe_Admin_2026!

# ===== 可选（有 fallback）=====

# 镜像版本（默认 0.11.32，社区 dev 模式最新稳定版）
_LANGSMITH_IMAGE_VERSION=0.11.32

# 镜像仓库（默认 docker.io；自建 harbor 时改 harbor.local）
_REGISTRY=docker.io

# 日志级别（debug/info/warning/error）
LOG_LEVEL=info

# 认证类型（none / mixed / oauth）
AUTH_TYPE=none

# Basic Auth（生产建议开，本环境内网 dev 关）
BASIC_AUTH_ENABLED=false
BASIC_AUTH_JWT_SECRET=

# JWT secret（同 API_KEY_SALT 即可，dev 模式可相同）
# 生成：openssl rand -base64 32
JWT_SECRET=

# OAuth（仅 AUTH_TYPE=oauth 时填）
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ISSUER_URL=

# ===== 存储密码（与 docker-compose.yml 内引用保持一致）=====
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=password
CLICKHOUSE_DB=default

# ===== ClickHouse / Postgres 连接 URI（dev 模式用默认即可）=====
POSTGRES_DATABASE_URI=postgres:postgres@langchain-db:5432/postgres
REDIS_DATABASE_URI=redis://langchain-redis:6379
CLICKHOUSE_HOST=langchain-clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_TLS=false

# ===== Optional：Playground 用 OpenAI Key（agentx 不依赖，可留空）=====
OPENAI_API_KEY=

# ===== Optional：trace TTL（生产用，dev 留空）=====
TRACE_TIER_TTL_DURATION_SEC_MAP=
TTL_ENABLED=true
CH_SEARCH_ENABLED=true
ORG_CREATION_DISABLED=false

# ===== Optional：S3 Blob Storage（生产推荐开，dev 留空）=====
BLOB_STORAGE_ENABLED=false
BLOB_STORAGE_BUCKET_NAME=langsmith-s3-assets
BLOB_STORAGE_API_URL=https://s3.us-west-2.amazonaws.com
BLOB_STORAGE_ACCESS_KEY=
BLOB_STORAGE_ACCESS_KEY_SECRET=

# ===== Optional：LANGSMITH_URL（前端回调地址，dev 用容器内默认）=====
LANGSMITH_URL=http://langchain-frontend:1980
SMITH_BACKEND_ENDPOINT=http://langchain-backend:1984