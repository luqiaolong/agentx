{
  "name": "agentx",
  "version": "0.1.0",
  "description": "本地优先的个人助理桌面应用",
  "main": "out/main/index.js",
  "author": "agentx",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icons": "python scripts/generate-icon.py && cargo tauri icon build/icon.png -o src-tauri/icons",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.26",
    "@assistant-ui/react-markdown": "^0.14.5",
    "@assistant-ui/styles": "^0.3.5",
    "@xyflow/react": "^12.3.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dugite": "^3.2.2",
    "electron-store": "^10.0.0",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.456.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.53.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^6.27.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^1.22.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "electron-updater": "^6.3.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.0",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.agentx.desktop",
    "productName": "AgentX",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": "AppImage"
    }
  }
}
